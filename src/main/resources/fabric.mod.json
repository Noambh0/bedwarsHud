{
  "schemaVersion": 1,
  "id": "bedwarshud",
  "version": "${version}",
  "name": "Bed Wars HUD",
  "description": "A lightweight client-side bed status HUD for Hypixel Bed Wars.",
  "authors": [
    "Noambh0"
  ],
  "contact": {
    "sources": "https://github.com/Noambh0/bedwarsHud"
  },
  "license": "MIT",
  "icon": "assets/bedwarshud/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.bedwarshud.BedWarsHudClient"
    ]
  },
  "mixins": [
    {
      "config": "bedwarshud.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.6"
  }
}
